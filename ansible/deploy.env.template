# env file for local Ansible deployments. Copy to deploy.env and
# modify as appropriate. Note that this it is about deploying _from_
# your local machine, not about deploying _to_ your local machine.
# It enables you to execute an Ansible deployment in exactly the
# same way as in the GitLab pipeline you defined in .gitlab-ci.yml


export VAULT_SERVER_URL=https://vault.naturalis.io
export VAULT_PATH=bii/bmd
# Host to which to deploy the application. See ./inventory/hosts.yml
export ANSIBLE_HOST=dev

export CI_REGISTRY=registry.gitlab.com
export CI_REGISTRY_IMAGE=registry.gitlab.com/naturalis/bii/bmd/bmd-dataspace-api
export CI_REGISTRY_USER=
# Your GitLab access token:
export CI_REGISTRY_PASSWORD=

# Optionally specify the tag of the container image to be deployed. By default,
# the image tagged with the git branch you are working on (CI_COMMIT_REF_SLUG)
# is deployed.
export IMAGE_TAG=
