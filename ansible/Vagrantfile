VAGRANTFILE_API_VERSION = "2"
Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|

  # Define the VM
  config.vm.define "vagrant1" do |v|
    v.vm.box = "ubuntu/jammy64"

    # Network configurations
    v.vm.network "forwarded_port", id: "ssh", guest: 22, host: 2222
    v.vm.network "forwarded_port", id: "http", guest: 80, host: 8080
    v.vm.network "forwarded_port", id: "https", guest: 443, host: 8443
    v.vm.network "private_network", ip: "192.168.56.11"

    # Shell provisioner to install Docker v2 (with Docker Compose)
    v.vm.provision "shell", inline: <<-SHELL
      # Update the apt package list
      sudo apt-get update

      # Install dependencies
      sudo apt-get install -y apt-transport-https ca-certificates curl software-properties-common

      # Add Docker’s official GPG key and Docker repository
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

      # Update apt package list again to include Docker packages
      sudo apt-get update

      # Install Docker v2 (Docker Engine, CLI, and containerd)
      sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

      # Enable Docker service to start on boot
      sudo systemctl enable docker

      # Add the 'vagrant' user to the 'docker' group so you can run Docker without sudo
      sudo usermod -aG docker vagrant
    SHELL
  end
end
